# Salin file ini menjadi ".dev.vars" (tanpa .example) untuk testing lokal via `wrangler dev`.
# JANGAN commit file ".dev.vars" ke git (sudah masuk .gitignore).

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Opsional tapi SANGAT disarankan: secret token buat verifikasi webhook,
# supaya endpoint /telegram-webhook menolak request yang bukan dari Telegram.
# Isi dengan string acak (misal hasil `openssl rand -hex 32`), lalu daftarkan
# lewat parameter &secret_token=... saat setWebhook (lihat README).
TELEGRAM_WEBHOOK_SECRET=

# Opsional: batasi bot ini cuma bisa dipakai chat_id tertentu (dipisah koma,
# misal "111111111,222222222"). Kalau dikosongkan, bot terbuka untuk semua
# orang yang chat — TIDAK disarankan karena tiap analisis memicu banyak
# panggilan Groq API (biaya kuota). Chat_id Telegram-mu bisa dicek lewat
# bot seperti @userinfobot.
ALLOWED_CHAT_IDS=

# --- Groq API Keys ---
# GROQ_API_KEY = fallback / key dasar. WAJIB diisi.
# Kalau HANYA field ini yang diisi, semua AI (1-10) + AI Penyimpul akan
# berbagi 1 key yang sama. Ini bisa memicu error 429 Too Many Requests
# saat menjalankan 10 AI beruntun (kuota per-menit akun gratis Groq cepat habis).
GROQ_API_KEY=your_groq_api_key_here

# Opsional tapi SANGAT disarankan: isi key terpisah per AI analyst supaya
# tiap AI punya kuota rate-limit sendiri-sendiri, tidak saling rebutan.
# Kalau salah satu GROQ_API_KEY_<N> tidak diisi, otomatis fallback ke GROQ_API_KEY.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=

# Opsional: key ke-11, khusus untuk AI Penyimpul (tahap rangkuman akhir).
# Kalau kosong, fallback ke GROQ_API_KEY.
GROQ_SUMMARIZER_API_KEY=

# Opsional: override nama model kalau Groq deprecate model default.
# Cek model terbaru di https://console.groq.com/docs/models
GROQ_VISION_MODEL=
GROQ_SUMMARY_MODEL=
GROQ_TEXT_MODEL=

# --- MT5 Bridge (XAUUSD) ---
# Secret token buat verifikasi request dari mt5_bridge.py (script Python di
# laptop/VPS kamu yang connect ke MT5). WAJIB diisi (string acak, misal hasil
# `openssl rand -hex 32`), supaya orang lain tidak bisa push candle palsu
# atau nyolong hasil sinyal lewat endpoint /mt5-bridge/*.
MT5_BRIDGE_SECRET=

# Ukuran lot default untuk eksekusi otomatis ke MT5 (demo). Default 0.01
# kalau tidak diisi. Ini FIXED LOT sederhana, bukan position sizing
# berbasis % risiko akun.
MT5_DEFAULT_LOT=0.01

# --- Mode OTONOM (khusus XAUUSD) ---
# Saklar UTAMA trading otonom (analisa -> eksekusi -> TANPA kamu pencet
# apa-apa, jalan tiap 10 menit via auto-signal). HARUS diisi PERSIS "true"
# (huruf kecil semua) untuk aktif. Kalau kosong/apa pun selain "true",
# siklus auto TETAP jalan kirim sinyal teks seperti biasa, tapi TIDAK
# PERNAH eksekusi ke MT5 — cuma jalur manual (klik tombol Telegram) yang
# tetap bisa eksekusi otomatis.
MT5_AUTONOMOUS_XAUUSD=false

# Maksimal berapa trade yang boleh dieksekusi mode otonom per hari
# (default 5 kalau tidak diisi).
MT5_MAX_TRADES_PER_DAY=5

# Circuit breaker: kalau equity akun turun sekian % dari equity di awal
# hari (UTC), mode otonom BERHENTI eksekusi sampai hari berikutnya
# (default 3 kalau tidak diisi).
MT5_MAX_DAILY_LOSS_PCT=3
